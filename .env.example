# Copy to .env (never committed) and fill in. QuantLab reads these from the environment;
# the .env file is loaded automatically by the CLI if present. Secrets are never logged.

# SEC EDGAR fair-access policy requires a descriptive User-Agent with contact email.
QUANTLAB_SEC_USER_AGENT="QuantLab research your-email@example.com"

# Required by the paper runner (`quantlab paper start`). Both must be set exactly like this; anything
# else (or a missing value) makes the runner refuse to start. There is no live mode.
TRADING_MODE=PAPER
LIVE_TRADING=false

# Alpaca PAPER account keys (https://app.alpaca.markets -> Paper account -> API keys).
# These are used for (a) market data and (b) the paper-trading endpoint ONLY.
# QuantLab refuses to talk to the live trading endpoint; do not put live keys here.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Optional LLM providers (AI research layer is disabled until one is configured).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
